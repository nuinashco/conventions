"""Render config schemas to the YAML files that mirror them."""

{% include "shared/python/_future.jinja" %}
import json
from collections.abc import Iterable, Iterator, Mapping
from pathlib import Path
from types import UnionType
from typing import Any, Union, get_args, get_origin

from attrs import frozen
from pydantic import BaseModel
from pydantic.fields import FieldInfo
from pydantic_core import to_jsonable_python

from {{ core }}.config import Schema

HEADER = "# Generated by `make configs` from {schema}; edit the schema, not this file."
REQUIRED = "???"


@frozen
class ConfigFile:
    """A YAML file generated from one schema."""

    path: str  # Relative to the configs directory.
    schema: type[Schema]
    defaults: tuple[str, ...] = ()  # Hydra defaults list, written first.
    kind: str | None = None  # Fixed `kind` value of a family item's config.


def render(file: ConfigFile) -> str:
    """Return the YAML text for one file: every field, its default and description."""
    lines = [HEADER.format(schema=file.schema.__name__)]
    if file.defaults:
        lines += ["defaults:", *(f"  - {entry}" for entry in file.defaults)]
    lines.append("")
    values = {"kind": file.kind} if file.kind else {}
    lines += _fields(file.schema, values, indent=0, skip=_groups(file.defaults))
    return "\n".join(lines) + "\n"


def stale(files: Iterable[ConfigFile], root: Path) -> list[Path]:
    """Return the files under `root` whose content differs from their schema."""
    return [
        root / f.path
        for f in files
        if not (root / f.path).is_file()
        or (root / f.path).read_text(encoding="utf-8") != render(f)
    ]


def write(files: Iterable[ConfigFile], root: Path) -> list[Path]:
    """Rewrite the stale files under `root`; return their paths."""
    files = list(files)
    changed = stale(files, root)
    for f in files:
        path = root / f.path
        if path in changed:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(render(f), encoding="utf-8")
    return changed


def _groups(defaults: Iterable[str]) -> set[str]:
    """Return the groups a defaults list selects, e.g. `eval` in `eval: smoke`."""
    groups: set[str] = set()
    for entry in defaults:
        head = entry.split("#")[0]
        if ":" in head:
            groups.add(
                head.split(":")[0].strip().removeprefix("override ").split("@")[0]
            )
    return groups


def _fields(
    schema: type[BaseModel],
    values: Mapping[str, Any],
    *,
    indent: int,
    skip: set[str] | None = None,
) -> Iterator[str]:
    pad = " " * indent
    for name, field in schema.model_fields.items():
        if skip and name in skip:
            continue  # A defaults-list group provides this field.
        comment = f"  # {field.description}" if field.description else ""
        value = values.get(name, _default(field))
        nested = _model(field.annotation)
        if nested is not None and value is not None:
            yield f"{pad}{name}:{comment}"
            inner = value if isinstance(value, BaseModel) else None
            yield from _fields(nested, _as_values(inner), indent=indent + 2)
        else:
            yield f"{pad}{name}: {_scalar(value)}{comment}"


def _model(annotation: Any) -> type[BaseModel] | None:
    """Return the model class of a `Model` or `Model | None` annotation."""
    union = get_origin(annotation) in (Union, UnionType)
    options: tuple[Any, ...] = get_args(annotation) if union else (annotation,)
    models = [o for o in options if isinstance(o, type) and issubclass(o, BaseModel)]
    return models[0] if len(models) == 1 else None


def _default(field: FieldInfo) -> Any:
    if field.is_required():
        return REQUIRED
    return field.get_default(call_default_factory=True)


def _as_values(model: BaseModel | None) -> dict[str, Any]:
    if model is None:
        return {}
    return {name: getattr(model, name) for name in type(model).model_fields}


def _scalar(value: Any) -> str:
    if value == REQUIRED:
        return REQUIRED
    # JSON is valid flow-style YAML, and quoting keeps `${...}` strings intact.
    return json.dumps(to_jsonable_python(value), ensure_ascii=False)
