# Generated by `make configs` from MainConfig; edit the schema, not this file.

run_name: "${now:%Y-%m-%d_%H-%M-%S}"  # directory under runs/
seed: 42  # seeds random, numpy and torch
deterministic: false  # force deterministic torch kernels (slower)
log_level: "info"  # debug|info|warning|error
log_format: "auto"  # auto: console in a terminal, JSON otherwise
{% if use_wandb %}
tracker: null  # mirror the run to W&B; null: run dir only
wandb_project: "{{ project_name }}"  # W&B project
{% endif %}
