[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
requires-python = ">={{ python }}"
dependencies = [
    "attrs>=26.1",
    "click>=8.5",
    "hydra-core>=1.4.0rc1",  # 1.3.x crashes on Python 3.14 (argparse help check).
    "numpy>=2.5",
    "pydantic>=2.14",
    "rootutils>=1.0.7",
    "structlog>=26.1",
{% if use_wandb %}
    "wandb>=0.31",
{% endif %}
]

[project.scripts]
{{ cli }}-run = "{{ package }}.cli.run:main"
{{ cli }}-configs = "{{ package }}.cli.configs:main"

[dependency-groups]
dev = [
    "conventions-hooks",
    "import-linter>=2.15",
    "pre-commit>=4.7",
    "pyright[nodejs]>=1.1.414",
    "pytest>=9.1",
    "ruff>=0.17",
]

[tool.uv.sources]
{% include "shared/files/uv-sources.toml.jinja" %}

[build-system]
requires = ["uv_build>=0.12,<0.14"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{ package }}"

{% set ruff_src = ["src", "tests"] %}
{% set first_party = [package] %}
{% set print_allowed = ["src/" ~ package ~ "/cli/**", "scripts/**"] %}
{% set pyright_include = ["src", "tests", "scripts"] %}
{% set pyright_strict = ["src/" ~ package ~ "/core"] %}
{% set testpaths = ["tests"] %}
{% include "shared/files/pyproject-tools.toml.jinja" %}

[tool.importlinter]
root_package = "{{ package }}"

[[tool.importlinter.contracts]]
name = "Layers: cli on top, core at the bottom, every module placed"
type = "layers"
containers = ["{{ package }}"]
layers = ["cli", "config", "core"]
exhaustive = true
