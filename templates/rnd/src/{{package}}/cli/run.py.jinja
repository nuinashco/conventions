"""`{{ cli }}-run`: validate configs/main.yaml, seed, and start a run directory.

Usage:

    {{ cli }}-run                            # defaults from configs/main.yaml
    {{ cli }}-run seed=1 run_name=baseline   # Hydra overrides

Writes runs/<run_name>/ with the resolved config and its provenance.
"""

{% include "shared/python/_future.jinja" %}
import hydra
import rootutils
import structlog
from omegaconf import DictConfig

from {{ package }}.config import MainConfig
from {{ core }} import paths, runs, seeding
from {{ core }}.errors import cli_boundary
from {{ core }}.logging import configure_logging

# Loads .env and sets PROJECT_ROOT for ${oc.env:...} in configs.
rootutils.setup_root(__file__, indicator=".project-root")

log = structlog.stdlib.get_logger()


@hydra.main(config_path=str(paths.CONFIGS_DIR), config_name="main")
@cli_boundary
def main(dict_cfg: DictConfig) -> None:
    cfg = MainConfig.from_hydra(dict_cfg)
    configure_logging(level=cfg.log_level, fmt=cfg.log_format)
    seeding.seed_everything(cfg.seed, deterministic=cfg.deterministic)
    run_dir = runs.start_run(cfg, name=cfg.run_name)
{% if use_wandb %}
    if cfg.tracker == "wandb":
        runs.mirror_to_wandb(cfg, run_dir, project=cfg.wandb_project)
{% endif %}
    log.info("run_started", run_dir=str(run_dir), seed=cfg.seed)
