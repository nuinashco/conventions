"""Estimate pi, save it, and write the report's values (the lab's pipeline skeleton).

Usage:

    uv run labs/{{ number }}-{{ topic }}/scripts/run.py
    uv run labs/{{ number }}-{{ topic }}/scripts/run.py seed=1 samples=1000000
"""

{% include "shared/python/_future.jinja" %}
import hydra
import rootutils
import structlog
from omegaconf import DictConfig

from nuikit.errors import cli_boundary
from nuikit.logging import configure_logging
from nuikit.seeding import seed_everything

from {{ course }}.report import number, write_values
from {{ course }}.storage import Storage
from lab{{ number }}.config import MainConfig
from lab{{ number }}.estimate import estimate_pi

# Loads .env and sets PROJECT_ROOT for ${oc.env:...} in configs.
rootutils.setup_root(__file__, indicator=".project-root")

log = structlog.stdlib.get_logger()


@hydra.main(config_path="../config", config_name="run")
@cli_boundary
def main(dict_cfg: DictConfig) -> None:
    cfg = MainConfig.from_hydra(dict_cfg)
    configure_logging()
    rng = seed_everything(cfg.seed)

    pi = estimate_pi(rng, samples=cfg.samples)

    path = Storage(cfg.paths.data_dir).write({"pi": pi}, "estimate.json")
    values = {"piEstimate": number(pi, 4)}
    write_values(cfg.paths.report_dir / "generated" / "values.tex", values)
    log.info("estimate_written", path=str(path), pi=pi)


if __name__ == "__main__":
    main()
