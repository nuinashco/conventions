"""Report values for LaTeX: decimal-comma numbers and generated macros."""

{% include "shared/python/_future.jinja" %}
import re
from collections.abc import Mapping
from pathlib import Path

DIGITS = (
    "Zero",
    "One",
    "Two",
    "Three",
    "Four",
    "Five",
    "Six",
    "Seven",
    "Eight",
    "Nine",
)


def number(value: float, digits: int) -> str:
    """Format with a decimal comma: 0.06069 -> 0{,}0607; works in text and math mode."""
    text = f"{value:.{digits}f}"
    sign = "\\ensuremath{-}" if text.startswith("-") and float(text) != 0 else ""
    return sign + text.lstrip("-").replace(".", "{,}")


def macro_name(*parts: object) -> str:
    """Join parts into a letters-only macro name: ("v2", "mse") -> vTwoMse."""
    tokens = [t for part in parts for t in re.findall(r"[A-Za-z]+|\d", str(part))]
    words = [DIGITS[int(t)] if t.isdigit() else t for t in tokens]
    first, *rest = words
    return first[0].lower() + first[1:] + "".join(w[0].upper() + w[1:] for w in rest)


def write_values(path: Path, values: Mapping[str, str]) -> Path:
    """Write one LaTeX macro per value, so report.tex never contains typed numbers."""
    lines = [_macro(name, value) for name, value in sorted(values.items())]
    path.parent.mkdir(parents=True, exist_ok=True)
    header = "% Generated by the lab pipeline; do not edit.\n"
    path.write_text(header + "\n".join(lines) + "\n", encoding="utf-8")
    return path


def _macro(name: str, value: str) -> str:
    return "\\newcommand{\\" + name + "}{" + value + "}"
