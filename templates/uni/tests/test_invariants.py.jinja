"""Repository-wide invariants: every lab's generated configs are fresh."""

{% include "shared/python/_future.jinja" %}
from {{ core }} import configgen, labs


def test_generated_lab_configs_are_fresh():
    targets = labs.config_targets()
    stale = [p for files, root in targets for p in configgen.stale(files, root)]

    assert stale == [], "run `make configs`"
