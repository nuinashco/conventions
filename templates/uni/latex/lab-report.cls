% Lab report class. Each report sets \labnumber, \topic, \variant and \authors;
% course-wide values (discipline, teacher, group, institution) come from course.tex.
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{lab-report}[2026/10/18 lab report]
\LoadClass[11pt,a4paper]{article}

\RequirePackage[a4paper,margin=0.7in]{geometry}
\RequirePackage[english,ukrainian]{babel}
\RequirePackage{amsmath, amssymb}
% XeLaTeX with Unicode Computer Modern: the same look as pdflatex's CM fonts, but Ukrainian І/і
% stay Cyrillic in the PDF (T2A stores them as Latin I/i, which plagiarism checkers flag)
\RequirePackage{fontspec}
\setmainfont{CMU Serif}
\setsansfont{CMU Sans Serif}
\setmonofont{CMU Typewriter Text}
% babel's XeLaTeX captions say «Таблиця»; the team's reports use «Табл.»
\addto\captionsukrainian{\renewcommand{\tablename}{Табл.}}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{placeins}

\setcounter{totalnumber}{20}
\setcounter{topnumber}{20}
\setcounter{bottomnumber}{20}
\renewcommand{\topfraction}{.95}
\renewcommand{\bottomfraction}{.95}
\renewcommand{\textfraction}{.05}
\raggedbottom

\RequirePackage{listings}
\RequirePackage{color}

\definecolor{dkgreen}{rgb}{0,0.6,0}
\definecolor{gray}{rgb}{0.5,0.5,0.5}
\definecolor{mauve}{rgb}{0.58,0,0.82}

\RequirePackage{enumitem}

% generated assets live next to the report: generated/figures/*.pdf
\graphicspath{{generated/figures/}}

\RequirePackage{caption, subcaption}

\RequirePackage{indentfirst, titlesec}
\emergencystretch=2em
\titleformat{\section}{\centering\normalfont\Large\bfseries}
    {\thesection.}{0em}{ }
\titleformat{\subsection}{\centering\normalfont\large\bfseries}
    {\thesubsection.}{0em}{ }
\titleformat{\subsubsection}{\centering\normalfont\normalsize\bfseries}
    {\thesubsubsection.}{0em}{ }

\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=blue,
    urlcolor=blue,
    unicode=true
}

\renewcommand{\thefigure}{\arabic{section}.\arabic{figure}}
\renewcommand{\thetable}{\arabic{table}}
\newcommand{\task}[2]{\setcounter{section}{#1}\setcounter{figure}{0}\section*{Завдання #1. #2}}
% an unnumbered section after the task steps whose figures are still numbered N.1, N.2, …
\newcommand{\protocolsection}[2]{\setcounter{section}{#1}\setcounter{figure}{0}\section*{#2}}

\lstset{frame=tb,
  language=Python,
  aboveskip=3mm,
  belowskip=3mm,
  showstringspaces=false,
  columns=flexible,
  keepspaces=true,
  basicstyle={\small\ttfamily},
  numbers=none,
  numberstyle=\tiny\color{gray},
  keywordstyle=\color{blue},
  commentstyle=\color{dkgreen},
  stringstyle=\color{mauve},
  breaklines=true,
  breakatwhitespace=true,
  tabsize=3,
  % listings typeset symbols outside the code font via math mode
  literate={×}{{$\times$}}1 {·}{{$\cdot$}}1 {Σ}{{$\Sigma$}}1 {−}{{$-$}}1 {²}{{$^2$}}1
           {α}{{$\alpha$}}1 {ε}{{$\varepsilon$}}1 {ξ}{{$\xi$}}1 {σ}{{$\sigma$}}1 {Δ}{{$\Delta$}}1
           {∈}{{$\in$}}1 {≤}{{$\le$}}1 {≥}{{$\ge$}}1 {≈}{{$\approx$}}1 {→}{{$\to$}}1
           {–}{{--}}1 {—}{{---}}1 {…}{{\ldots}}1
}

\newcommand{\umova}[1]{\begin{quote}\itshape #1\end{quote}\noindent\textbf{Виконання.}\ }

% Title page
\newcommand{\labnumber}[1]{\def\lab@labnumber{#1}}
\newcommand{\topic}[1]{\def\lab@topic{#1}}
\newcommand{\variant}[1]{\def\lab@variant{#1}}
\newcommand{\studentgroup}[1]{\def\lab@studentgroup{#1}}
\newcommand{\authors}[2][Виконали:]{\def\lab@authorsheading{#1}\def\lab@authors{#2}}
\newcommand{\discipline}[1]{\def\lab@discipline{#1}}
\newcommand{\teacher}[1]{\def\lab@teacher{#1}}
\newcommand{\reportyear}[1]{\def\lab@reportyear{#1}}

\newcommand{\institution}[1]{\def\lab@institution{#1}}

\labnumber{}
\topic{}
\variant{}
\studentgroup{}
\authors{}
\discipline{}
\teacher{}
\reportyear{\the\year}
\institution{%
МІНІСТЕРСТВО ОСВІТИ І НАУКИ УКРАЇНИ\\
НАЦІОНАЛЬНИЙ ТЕХНІЧНИЙ УНІВЕРСИТЕТ УКРАЇНИ\\
<<КИЇВСЬКИЙ ПОЛІТЕХНІЧНИЙ ІНСТИТУТ ім. ІГОРЯ СІКОРСЬКОГО>>\\
Навчально-науковий інститут прикладного системного аналізу\\
Кафедра математичних методів системного аналізу}

% Course-wide values, generated by copier; a report may still override any of them.
\InputIfFileExists{course.tex}{}{}

\renewcommand{\maketitle}{%
\begin{titlepage}
\centering

{\small
\lab@institution\par}

\vspace{\stretch{1}}

\textsc{Практична робота №\lab@labnumber}

\vspace{0.5em}
з дисципліни <<\lab@discipline>>

\vspace{1.2em}
на тему:\par
\vspace{0.6em}
{\LARGE\bfseries\linespread{1.2}\selectfont
\lab@topic\par}
\vspace{0.5em}
\rule{3in}{0.4pt}

\ifx\lab@variant\@empty\else
\vspace{0.8em}
{\large Варіант №\lab@variant}
\fi

\vspace{\stretch{1}}

\begin{flushright}
\begin{minipage}{0.46\textwidth}
\raggedright
\textbf{\lab@authorsheading}\\
студенти гр. \lab@studentgroup\\
\lab@authors\\[0.8em]
\textbf{Перевірив:}\\
\lab@teacher
\end{minipage}
\end{flushright}

\vspace{\stretch{1}}

{\small
Київ -- \lab@reportyear}

\vspace*{\stretch{0.5}}
\end{titlepage}%
}
