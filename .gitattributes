# Files nobody edits by hand (GUIDE TOOL-5): `make build` writes them from rules/ and agents/.
# check-protected refuses agent edits to them and GitHub folds their diffs.
GUIDE.md linguist-generated protected=generated
COVERAGE.md linguist-generated protected=generated
src/conventions_hooks/doc_rules.md linguist-generated protected=generated
plugins/conventions/skills/** linguist-generated protected=generated
plugins/conventions/agents/** linguist-generated protected=generated

# The plugin's launcher keeps LF line endings on a checkout that turns text into CRLF
# (core.autocrlf), where `#!/bin/sh` would stop working.
plugins/conventions/scripts/run-check text eol=lf
