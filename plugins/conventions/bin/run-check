#!/bin/sh
# Runs one conventions-hooks command from the project's own virtualenv, so each project
# gets the version its uv.lock pins: run-check <command> [args...]. It exits 0 without
# output in a project that has not opted in with a [tool.conventions] table, or that has
# no such command installed, so the plugin fails open everywhere else.
command=${1:-}
[ -n "$command" ] || exit 0
shift
cd "${CLAUDE_PROJECT_DIR:-.}" 2>/dev/null || exit 0
grep -Eq '^[[:space:]]*\[tool\.conventions\]' pyproject.toml 2>/dev/null || exit 0
[ -x ".venv/bin/$command" ] || exit 0
exec ".venv/bin/$command" "$@"
