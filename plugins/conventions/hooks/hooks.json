{
  "description": "Run the project's own conventions-hooks checks through scripts/run-check; they do nothing in a repo without [tool.conventions].",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-check\" check-protected --claude-hook",
            "timeout": 30,
            "statusMessage": "Checking for protected files"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-check\" check-comments --claude-hook",
            "timeout": 30,
            "statusMessage": "Checking comment conventions"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-check\" check-conventions --claude-hook",
            "timeout": 30,
            "statusMessage": "Checking code conventions"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-check\" review-comments --claude-hook",
            "timeout": 600,
            "statusMessage": "Reviewing new comments in the background",
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
